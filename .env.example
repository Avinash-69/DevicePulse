# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# docker compose reads this file automatically. Every value below is required; the compose file
# fails fast with a named error rather than starting with a default, because a container that
# silently came up with a well-known password is worse than one that refused to start.

# SQL Server sa password. Must satisfy SQL Server's own policy:
# at least 8 characters with upper case, lower case, a digit and a symbol.
SQL_PASSWORD=

# JWT signing key, at least 32 characters. Generate a fresh one, for example:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# The initial Super Admin. Change the password immediately after first sign-in.
SUPERADMIN_EMAIL=superadmin@devicepulse.local
SUPERADMIN_PASSWORD=
