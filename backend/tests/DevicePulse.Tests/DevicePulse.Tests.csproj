<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables that host the Microsoft Testing Platform. -->
    <OutputType>Exe</OutputType>
    <CodePage>65001</CodePage>
    <!-- Opt in to the Testing Platform runner, which `dotnet test` on the .NET 10 SDK requires
         for xUnit v3 (the older VSTest path is no longer supported). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- xUnit1051 asks every CancellationToken-accepting call to thread
         TestContext.Current.CancellationToken. Valuable in long suites; here it would add
         noise to assertions whose point is the HTTP status code, so it is off. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 over v2 for Assert.Skip: it lets the integration suite skip cleanly when no
         local SQL Server is reachable, instead of reporting false failures. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevicePulse.Api\DevicePulse.Api.csproj" />
  </ItemGroup>

</Project>
